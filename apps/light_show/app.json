{
  "id": "light_show",
  "title": "Light Show",
  "description": "Flash the exterior lamps through the body controller's lamp test functions: patterns, your own sequences (a JSON timeline), a custom strobe, and manual control of each lamp group. Rate-limited, with thermal limits, and every lamp handed back to the car on stop, pause, leaving the screen or the app closing.",
  "version": "0.6.0",
  "vendor": "custom",
  "loggingId": "OA9F",
  "iconGlyph": "lights",
